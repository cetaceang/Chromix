+// UXR: fill missing phases only within a complete, non-reused connection.
+struct PersonaNetPhases {
+  bool dns_active = false;
+  bool ssl_active = false;
+  double dns_start = 0.0;
+  double dns_end = 0.0;
+  double ssl_start = 0.0;
+};
+
+PersonaNetPhases ComputePersonaNetPhases(
+    const PerformanceResourceTiming& entry,
+    const mojom::blink::ResourceTimingInfo& info,
+    base::TimeTicks time_origin,
+    bool cross_origin_isolated_capability) {
+  PersonaNetPhases ph;
+  base::UxrConfig& ph_cfg = base::UxrConfig::GetInstance();
+  // Check before calling any getter: missing send timing uses phase fallbacks.
+  if (!ph_cfg.Has("uxr-net-timing") || !info.allow_timing_details ||
+      info.did_reuse_connection || !info.timing ||
+      info.timing->send_start.is_null() || !info.timing->connect_timing) {
+    return ph;
+  }
+  const auto& timing = *info.timing;
+  const auto& connect = *timing.connect_timing;
+  if (connect.connect_start.is_null() || connect.connect_end.is_null() ||
+      connect.connect_end < connect.connect_start ||
+      timing.send_start < connect.connect_end) {
+    return ph;
+  }
+  const bool missing_dns = connect.domain_lookup_start.is_null();
+  // Partial DNS data keeps Chromium's native fallback and trimming semantics.
+  if (missing_dns != connect.domain_lookup_end.is_null() ||
+      (!missing_dns &&
+       (connect.domain_lookup_end < connect.domain_lookup_start ||
+        connect.domain_lookup_end < connect.connect_start ||
+        connect.connect_end < connect.domain_lookup_end))) {
+    return ph;
+  }
+  const auto to_dom = [&](base::TimeTicks time) {
+    return Performance::MonotonicTimeToDOMHighResTimeStamp(
+        time_origin, time, info.allow_negative_values,
+        cross_origin_isolated_capability);
+  };
+  // Use Chromium's DNS-trimmed connectStart, without entering phase getters.
+  const double conn_start = to_dom(missing_dns ? connect.connect_start
+                                             : connect.domain_lookup_end);
+  const double conn_end = to_dom(connect.connect_end);
+  const double send_start = to_dom(timing.send_start);
+  const double fetch_start = entry.fetchStart();
+  if (!(fetch_start <= conn_start && conn_start <= conn_end &&
+        conn_end <= send_start)) {
+    return ph;
+  }
+
+  uint32_t ph_seed = 0;
+  if (ph_cfg.Has("uxr-canvas-seed")) {
+    base::StringToUint(ph_cfg.Get("uxr-canvas-seed"), &ph_seed);
+  }
+  uint32_t ph_salt = ph_seed;
+  const std::string ph_name = entry.name().Utf8();
+  for (char ph_c : ph_name) {
+    ph_salt = ph_salt * 31u + static_cast<unsigned char>(ph_c);
+  }
+  ph_salt ^= ph_salt >> 15;
+  ph_salt *= 0x2545f491u;
+  ph_salt ^= ph_salt >> 13;
+
+  if (missing_dns) {
+    const double dns_duration = 2.0 + (ph_salt % 13u);
+    const double scale =
+        std::min(1.0, (conn_start - fetch_start) / (dns_duration + 1.0));
+    ph.dns_active = true;
+    ph.dns_start = std::min(conn_start, fetch_start + scale);
+    ph.dns_end = std::min(conn_start, ph.dns_start + dns_duration * scale);
+  }
+  if (info.is_secure_transport && connect.ssl_start.is_null()) {
+    double ssl_end = conn_end;
+    if (!connect.ssl_end.is_null()) {
+      ssl_end = std::min(ssl_end, to_dom(connect.ssl_end));
+    }
+    if (conn_start <= ssl_end) {
+      ph.ssl_active = true;
+      ph.ssl_start =
+          std::min(ssl_end, conn_start + 1.0 + ((ph_salt >> 6) % 4u));
+    }
+  }
+  return ph;
+}
