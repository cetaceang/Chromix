+bool IsUxrVideoCodecAllowed(VideoCodec codec) {
+  const char* key = nullptr;
+  switch (codec) {
+    case VideoCodec::kH264: key = "uxr-codec-h264"; break;
+    case VideoCodec::kVP8: key = "uxr-codec-vp8"; break;
+    case VideoCodec::kVP9: key = "uxr-codec-vp9"; break;
+    case VideoCodec::kAV1: key = "uxr-codec-av1"; break;
+    case VideoCodec::kHEVC: key = "uxr-codec-hevc"; break;
+    default: return true;
+  }
+  const auto& config = base::UxrConfig::GetInstance();
+  if (!config.Has(key))
+    return true;
+  const std::string value = config.Get(key);
+  if (value == "native")
+    return true;
+  // SetAll validates the exact token grammar before this immutable policy is
+  // published. The separators keep partial tokens from enabling a backend.
+  return ("," + value + ",").find(",supported,") != std::string::npos;
+}
+
+bool HasUxrVideoCodecRestrictions() {
+  for (VideoCodec codec : {VideoCodec::kH264, VideoCodec::kVP8, VideoCodec::kVP9,
+                           VideoCodec::kAV1, VideoCodec::kHEVC}) {
+    if (!IsUxrVideoCodecAllowed(codec))
+      return true;
+  }
+  return false;
+}
