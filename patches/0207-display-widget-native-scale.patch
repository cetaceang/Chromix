+display::ScreenInfo OrientationScreenInfo(display::ScreenInfo screen_info) {
+  using Orientation = display::mojom::blink::ScreenOrientation;
+  if (screen_info.orientation_type != Orientation::kUndefined) {
+    return screen_info;
+  }
+  // Match ScreenOrientationController's fallback, including web tests.
+  if (WebTestSupport::IsRunningWebTest()) {
+    screen_info.orientation_type = Orientation::kPortraitPrimary;
+    return screen_info;
+  }
+  const auto& rect = screen_info.rect;
+  const bool tall = screen_info.orientation_angle % 180
+                        ? rect.height() < rect.width()
+                        : rect.height() > rect.width();
+  switch (screen_info.orientation_angle) {
+    case 0:
+      screen_info.orientation_type =
+          tall ? Orientation::kPortraitPrimary : Orientation::kLandscapePrimary;
+      break;
+    case 90:
+      screen_info.orientation_type = tall ? Orientation::kLandscapePrimary
+                                          : Orientation::kPortraitSecondary;
+      break;
+    case 180:
+      screen_info.orientation_type = tall ? Orientation::kPortraitSecondary
+                                          : Orientation::kLandscapeSecondary;
+      break;
+    case 270:
+      screen_info.orientation_type = tall ? Orientation::kLandscapeSecondary
+                                          : Orientation::kPortraitPrimary;
+      break;
+    default:
+      NOTREACHED();
+  }
+  return screen_info;
+}
 
