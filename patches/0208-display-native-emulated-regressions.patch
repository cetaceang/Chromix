+TEST_F(WebFrameWidgetImplRemoteFrameSimTest,
+       EmulatedScreenPreservesNativeLayoutAndInputScale) {
+  auto* widget = LocalFrameRootWidget();
+  display::ScreenInfo native_screen;
+  native_screen.rect = gfx::Rect(800, 600);
+  native_screen.available_rect = native_screen.rect;
+  VisualProperties properties;
+  properties.screen_infos = display::ScreenInfos(native_screen);
+  display::ScreenInfo emulated_screen = native_screen;
+  emulated_screen.rect = gfx::Rect(1920, 1080);
+  emulated_screen.available_rect = gfx::Rect(1920, 1040);
+  emulated_screen.device_scale_factor = 1.25f;
+  properties.emulated_screen_infos = display::ScreenInfos(emulated_screen);
+  properties.new_size_device_px = gfx::Size(300, 150);
+  properties.visible_viewport_size_device_px = gfx::Size(800, 600);
+  properties.compositor_viewport_pixel_rect = gfx::Rect(300, 150);
+  auto check = [&](int width, int height, float dpr, float native_dsf) {
+    widget->ApplyVisualProperties(properties);
+    widget->UpdateAllLifecyclePhases(DocumentUpdateReason::kTest);
+    auto* window = LocalFrameRoot().GetFrame()->DomWindow();
+    EXPECT_EQ(width, window->innerWidth());
+    EXPECT_EQ(height, window->innerHeight());
+    EXPECT_FLOAT_EQ(dpr, window->devicePixelRatio());
+    EXPECT_FLOAT_EQ(native_dsf,
+                    widget->LayerTreeHostForTesting()->device_scale_factor());
+    EXPECT_EQ(properties.screen_infos, widget->GetOriginalScreenInfos());
+    EXPECT_EQ(properties.emulated_screen_infos, widget->GetEmulatedScreenInfos());
+    EXPECT_EQ(gfx::PointF(37 * native_dsf, 19 * native_dsf),
+              widget->DIPsToBlinkSpace(gfx::PointF(37, 19)));
+    EXPECT_EQ(gfx::RectF(37, 19, 50, 20),
+              widget->BlinkSpaceToDIPs(gfx::RectF(37 * native_dsf, 19 * native_dsf,
+                                                50 * native_dsf, 20 * native_dsf)));
+  };
+  check(300, 150, 1.25f, 1.f);
+  EXPECT_EQ(emulated_screen.rect, widget->GetScreenInfo().rect);
+  EXPECT_EQ(emulated_screen.available_rect,
+            widget->GetScreenInfo().available_rect);
+  properties.emulated_screen_infos->mutable_current().device_scale_factor = 2.f;
+  check(300, 150, 2.f, 1.f);
+  properties.new_size_device_px = gfx::Size(420, 210);
+  properties.compositor_viewport_pixel_rect = gfx::Rect(420, 210);
+  check(420, 210, 2.f, 1.f);
+  properties.zoom_level = ZoomFactorToZoomLevel(2.f);
+  check(210, 105, 4.f, 1.f);
+  properties.zoom_level = 0;
+  properties.page_scale_factor = 1.5f;
+  properties.is_pinch_gesture_active = true;
+  check(420, 210, 2.f, 1.f);
+  EXPECT_TRUE(widget->LayerTreeHostForTesting()
+                  ->is_external_pinch_gesture_active_for_testing());
+  properties.css_zoom_factor = 2.f;
+  properties.new_size_device_px = gfx::Size(840, 420);
+  properties.compositor_viewport_pixel_rect = gfx::Rect(840, 420);
+  check(420, 210, 4.f, 1.f);
+  properties.css_zoom_factor = 1.f;
+  properties.screen_infos.mutable_current().device_scale_factor = 2.f;
+  properties.emulated_screen_infos->mutable_current().device_scale_factor = 1.25f;
+  check(420, 210, 1.25f, 2.f);
+  properties.emulated_screen_infos.reset();
+  check(420, 210, 2.f, 2.f);
+  EXPECT_EQ(properties.screen_infos, widget->GetScreenInfos());
+}
